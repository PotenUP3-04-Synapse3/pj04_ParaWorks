PARAWORKS_ENV=local
PARAWORKS_DEMO_MODE=true
PARAWORKS_API_HOST=127.0.0.1
PARAWORKS_API_PORT=8000
PARAWORKS_POSTGRES_PORT=5432
PARAWORKS_REDIS_PORT=6379
DATABASE_URL=postgresql+psycopg://paraworks:paraworks@127.0.0.1:5432/paraworks
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=true
OPENAI_API_KEY=your-openai-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_TIMEOUT_SECONDS=30
OPENAI_EMBEDDING_INPUT_COST_PER_1M_TOKENS=0.02
GEMINI_API_KEY=your-gemini-key-here
GOOGLE_API_KEY=
AGENT_LLM_ENABLED=false
AGENT_LLM_PROVIDER_ORDER=openai,gemini
AGENT_LLM_OPENAI_MODEL=gpt-4.1-mini
AGENT_LLM_GEMINI_MODEL=gemini-2.5-flash
AGENT_LLM_INPUT_COST_PER_1M_TOKENS=0.15
AGENT_LLM_OUTPUT_COST_PER_1M_TOKENS=0.60
AGENT_LLM_MAX_ESTIMATED_COST_USD=0.001
AGENT_LLM_MAX_INPUT_CHARS=12000
AGENT_LLM_MAX_EVIDENCE_MESSAGES=12
AGENT_LLM_MAX_OUTPUT_TOKENS=512
AGENT_LLM_TEMPERATURE=0.2
AGENT_LLM_TIMEOUT_SECONDS=30
RAG_EMBEDDING_MAX_ESTIMATED_COST_USD=0.001
RAG_USE_PGVECTOR_SEARCH=false
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=paraworks
MINIO_SECRET_KEY=paraworks-secret
MINIO_BUCKET=paraworks-sources
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Future real Slack connector configuration. Keep unset for mock/demo mode.
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_CHANNEL_IDS=C0AUJDZUKA8
SLACK_WORKSPACE_URL=https://3aiagent.slack.com
SLACK_CLIENT_ID=your-client-id
SLACK_CLIENT_SECRET=your-client-secret
SLACK_OAUTH_REDIRECT_URI=http://localhost:3000/integrations/slack/callback
SLACK_OAUTH_STATE_SECRET=replace-with-local-random-state-secret

# Google OAuth is split by purpose:
# - GOOGLE_OAUTH_REDIRECT_URI is for Gmail/Drive/Calendar data integrations.
# - GOOGLE_IDENTITY_REDIRECT_URI is for ParaWorks login only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/integrations/google/callback
GOOGLE_OAUTH_STATE_SECRET=replace-with-local-google-data-state-secret
GOOGLE_IDENTITY_REDIRECT_URI=http://localhost:3000/login/google/callback
GOOGLE_IDENTITY_STATE_SECRET=replace-with-local-google-login-state-secret

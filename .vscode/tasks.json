{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: Start",
      "type": "shell",
      "command": ".venv\\Scripts\\uvicorn.exe",
      "args": [
        "app.main:app",
        "--app-dir", "backend",
        "--reload",
        "--port", "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "panel": "dedicated",
        "group": "servers"
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Start",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "presentation": {
        "panel": "dedicated",
        "group": "servers"
      },
      "problemMatcher": []
    },
    {
      "label": "Start All",
      "dependsOn": ["Backend: Start", "Frontend: Start"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
